{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Env Reaper",
  "version": "0.1.0",
  "identifier": "dev.envreaper.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Env Reaper",
        "width": 1440,
        "height": 980,
        "minWidth": 800,
        "minHeight": 650,
        "backgroundColor": "#141713"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "A local-first environment configuration workbench",
    "category": "DeveloperTool",
    "icon": ["icons/icon.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
